# Copy to .env.local after connecting your own Expo/EAS project.
# Project identifiers are public. Never put service-account private keys here.
EXPO_ACCOUNT_OWNER=
EAS_PROJECT_ID=
EXPO_PUBLIC_NOTIFICATIONS_API_URL=https://svitlo-notifications-pilot.svitlonorify.workers.dev

# Uncomment after downloading this Android configuration from Firebase.
# It must contain the package ua.svitlo.rn.development for the pilot build.
# GOOGLE_SERVICES_JSON=./.credentials/development/google-services.json
