<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/svitlo_widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top" android:baselineAligned="false">
        <TextView android:id="@+id/widget_location" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingEnd="8dp" android:text="ЄСвітло" android:textSize="18sp" android:textColor="#F5F5F5" android:fontFamily="@font/svitlo_inter" />
        <TextView android:id="@+id/widget_status" android:layout_width="0dp" android:layout_weight="1.3" android:layout_height="wrap_content" android:gravity="end" android:text="Налаштуйте віджет" android:textSize="16sp" android:textColor="#2ECC71" android:fontFamily="@font/svitlo_inter" />
    </LinearLayout>
    <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="10sp" android:textColor="#B8B8B8" android:fontFamily="@font/svitlo_inter" />
    <TextView android:id="@+id/widget_countdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="13sp" android:textColor="#F5F5F5" android:fontFamily="@font/svitlo_inter" />
    <TextView android:id="@+id/widget_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#FFC166" android:fontFamily="@font/svitlo_inter" />
    <ImageView android:id="@+id/widget_timeline" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="6dp" android:scaleType="fitXY" />
    <LinearLayout android:id="@+id/widget_columns" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:baselineAligned="false">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:paddingEnd="6dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Сьогодні" android:textColor="#2ECC71" android:textSize="15sp" android:fontFamily="@font/svitlo_inter" />
            <LinearLayout android:id="@+id/widget_today_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <TextView android:id="@+id/widget_today_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="36dp" android:gravity="center_vertical" android:textColor="#2ECC71" android:textSize="12sp" android:fontFamily="@font/svitlo_inter" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="6dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Завтра" android:textColor="#2ECC71" android:textSize="15sp" android:fontFamily="@font/svitlo_inter" />
            <LinearLayout android:id="@+id/widget_tomorrow_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <TextView android:id="@+id/widget_tomorrow_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="36dp" android:gravity="center_vertical" android:textColor="#2ECC71" android:textSize="12sp" android:fontFamily="@font/svitlo_inter" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_refresh" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:text="↻ Оновити" android:textColor="#2ECC71" android:textSize="12sp" android:fontFamily="@font/svitlo_inter" />
        <TextView android:id="@+id/widget_configure" android:layout_width="48dp" android:layout_height="match_parent" android:gravity="center" android:text="⚙" android:textSize="20sp" android:textColor="#B8B8B8" android:contentDescription="Обрати локацію віджета" />
    </LinearLayout>
</LinearLayout>
